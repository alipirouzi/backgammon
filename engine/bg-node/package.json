{
  "name": "bg-node",
  "version": "0.1.0",
  "private": true,
  "description": "Native Node.js binding of the backgammon engine (napi-rs, JSON in/out)",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "bg-node",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "x86_64-apple-darwin"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node --test \"__test__/**/*.test.mjs\"",
    "pretest": "napi build --platform --release"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.9.0"
  }
}

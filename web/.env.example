# Copy to web/.env (gitignored) for `next dev` / `next start` and the Prisma CLI,
# which load it themselves; Vitest and Playwright do not read .env files, so for
# `pnpm test` and `pnpm test:e2e` export the variable in the shell instead
# (`set -a; . web/.env; set +a`). The value below matches web/docker-compose.dev.yml
# ("dev" is a local throwaway password, not a secret). Production composes
# DATABASE_URL from POSTGRES_PASSWORD in deploy/docker-compose.prod.yml.
DATABASE_URL=postgresql://backgammon:dev@127.0.0.1:5439/backgammon
